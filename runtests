#!/usr/bin/env python
"""Run the nose2 suite or reviewed test labels."""

import sys

from openwisp_utils.test.runner import (
    InvalidTestArgument,
    compile_test_label_pattern,
    parse_test_arguments,
    validate_test_labels,
)


def main():
    pattern = compile_test_label_pattern(module_roots=("tests", "tests.test_snmp"))
    try:
        labels, _ = parse_test_arguments(
            sys.argv[1:],
            pattern,
            ("-v", "-q", "-F", "--verbose", "--quiet", "--fail-fast"),
        )
        validate_test_labels(labels)
    except InvalidTestArgument as error:
        print(error, file=sys.stderr)
        return 2
    import nose2

    nose2.discover()
    return 0


if __name__ == "__main__":
    sys.exit(main())
